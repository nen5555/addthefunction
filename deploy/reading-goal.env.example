# 复制到 ~/.config/reading-goal.env 后填写，权限设为 600（只有自己能读）
KAVITA_API_KEY=在这里填你的Kavita API Key
TZ=Asia/Shanghai

# 以下为可选项，不写就用默认值
# KAVITA_URL=http://localhost:5000
# KAVITA_USER_ID=1
# KAVITA_TZ=Asia/Shanghai
# GOAL_MINUTES=10
# LISTEN_HOST=127.0.0.1
# LISTEN_PORT=5100
# CACHE_SECONDS=60

# ---- 网页上传书籍（不设置 LIBRARY_DIR 就不开启）----
# 本机上 Kavita 书库文件夹的路径。Kavita 跑在 Docker 里时，填 -v 左边的宿主机路径，不是容器里的 /books
# LIBRARY_DIR=/home/time/books
# 上传后扫描哪个书库（Kavita 书库设置页 URL 里的数字）；不写或 0 = 扫描全部书库
# UPLOAD_LIBRARY_ID=1
# 单次上传大小上限（MB）
# UPLOAD_MAX_MB=300
